<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tk.app.mapper.ManageWorkMapper">

	<!-- 워크 활동하는 사람 직위 조회 -->
	<select id="findWorkRole" parameterType="map" resultType="int">
		SELECT MAX(role)
		FROM workspace_members
		WHERE  workspace_id = #{workspaceId} AND member_id = #{actorId} AND status = 0
	</select>
	
	<!-- 사장만 목록 조회 -->
	<sql id="workCheck">
	
	</sql>
</mapper>